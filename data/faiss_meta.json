  },
  {
    "fact_id": "c2902805-94be-4606-88db-23c6724cdca0",
    "session_id": "demo-session",
    "text": "Cross-attention attends to the encoded representation of the input sequence from the encoder to the decoder.",
    "category": "technical",
    "importance": 0.45,
