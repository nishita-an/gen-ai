v.in/sra-automation/sra-website/sub-category/json/1758641897242_9581_data.json\",\"is_show_in_citizen_service\":true,\"is_department\":false},{\"_id\":\"670010199aae54b68d4f7547\",\"name\":\"Transfer of Tenement\",\"category_id\":\"66fffff993bb6712dcc047b9\",\"language\":\"English\",\"unique_path\":\"transfer-of-tenement\",\"priority\":3,\"status\":true,\"is_new\":true,\"menu_type\":\"Content\",\"description\":\"$1a\",\"pdf_url\":null,\"website_url\":\"https://www.google.com\",\"meta_keyword\":\"Transfer Of Tenement\",\"meta_description\":\"Transfer Of Tenement\",\"short_description\":\"The following documents are required for the transfer of ownership of slum properties, in accordance with Section 3 (E) of the Maharashtra Slum Areas (Improvement, Clearance, and Redevelopment) Act, 1971, and Circular No. 145 issued by the Slum Rehabilitation Authority on 24.10.2021.\",\"from_date\":\"2024-10-04T15:54:01.913Z\",\"to_date\":\"2025-04-30T15:54:01.000Z\",\"created_by\":\"6700f2f7b66d9af204113940\",\"createdAt\":\"2024-10-04T15:56:09.213Z\",\"updatedAt\":\"2025-09-25T07:09:26.581Z\",\"__v\":0,\"image_url\":\"https://media.sra.gov.in/sra-automation/sra-website/sub-category/json/1758783903034_6093_data.json\",\"location\":\"Header\",\"is_open_new_tab\":false,\"is_show_in_citizen_service\":true},{\"_id\":\"67ed3a3cb5a1a5faff12718f\",\"name\":\"PAP House Allotment\",\"category_id\":\"66fffff993bb6712dcc047b9\",\"image_url\":\"https://media.sra.gov.in/sra-automation/sra-website/sub-category/json/1758641978173_3267_data.json\",\"language\":\"English\",\"unique_path\":\"pap-house-allotment\",\"priority\":3,\"status\":true,\"is_new\":true,\"menu_type\":\"Website URL\",\"is_open_new_tab\":true,\"description\":null,\"pdf_url\":null,\"website_url\":\"https://pap.sra.gov.in\",\"meta_keyword\":null,\"meta_description\":null,\"short_description\":\"PAP House Allotment\",\"from_date\":\"2025-04-24T18:30:00.000Z\",\"to_date\":\"2025-05-27T18:30:00.000Z\",\"created_by\":\"670cc225ab2f5d2be883087a\",\"location\":\"Header\",\"createdAt\":\"2025-04-02T13:23:08.588Z\",\"updatedAt\":\"2026-03-23T05:34:42.707Z\",\"__v\":0,\"is_show_in_citizen_service\":true,\"is_department\":false},{\"_id\":\"67037d5d2fe369d10533716c\",\"name\":\"Rent Complaint\",\"category_id\":\"66fffff993bb6712dcc047b9\",\"language\":\"English\",\"unique_path\":\"rent-complaint\",\"priority\":5,\"status\":true,\"is_new\":true,\"menu_type\":\"Website URL\",\"description\":\"\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\",\"pdf_url\":null,\"website_url\":\"https://aaplesarkar.mahaonline.gov.in/en\",\"meta_keyword\":\"Scheme Information\",\"meta_description\":\"Scheme Information\",\"short_description\":\"Citizen has to register themselves on the portal. While registration, the basic details like name, mobile number, email will be taken.After registration, a user can log the rent related complain for themselves or for their family members.While registering the complain, basic details like name, rent details, bank details, previous payment details needs to be filled.User can also upload supporting documents like, Aadhar card, bank passbook, Annexure II and rent agreement.User can see the status of their existing application under the application list section.User can resubmit any application if it has been rejected.\",\"from_date\":\"2024-10-15T18:30:00.000Z\",\"to_date\":\"2025-05-30T18:30:00.000Z\",\"created_by\":\"670cc225ab2f5d2be883087a\",\"location\":\"Header\",\"createdAt\":\"2024-10-07T06:19:09.059Z\",\"updatedAt\":\"2025-12-12T07:41:39.526Z\",\"__v\":0,\"image_url\":\"https://media.sra.gov.in/sra-automation/sra-website/sub-category/json/1758637724866_7316_data.json\",\"is_open_new_tab\":false,\"is_show_in_citizen_service\":true,\"is_department\":false},{\"_id\":\"696480013f90645fdfb74bb3\",\"name\":\"SRA Kavach\",\"category_id\":\"66fffff993bb6712dcc047b9\",\"language\":\"English\",\"unique_path\":\"sra-kavach\",\"priority\":10,\"status\":true,\"is_new\":false,\"menu_type\":\"Content\",\"is_open_new_tab\":false,\"description\":\"$1b\",\"pdf_url\":null,\"website_url\":null,\"meta_keyword\":\"SRA Kavach\",\"meta_description\":\"SRA Kavach\",\"short_description\":\"SRA Kavach is a secure digital system introduced by the Slum Rehabilitation Authority (SRA), Mumbai, to protect important documents from forgery and misuse.\",\"from_date\":null,\"to_date\":null,\"created_by\":\"670cc225ab2f5d2be883087a\",\"location\":\"Header\",\"is_show_in_citizen_service\":true,\"is_show_in_departments\":false,\"is_department\":false,\"createdAt\":\"2026-01-12T05:00:49.178Z\",\"updatedAt\":\"2026-02-24T07:04:17.396Z\",\"__v\":0,\"image_url\":\"https://media.sra.gov.in/sra-automation/sra-website/sub-category/json/1771916549805_3279_data.json\"}]},\"children\":\"$L1c\"}]}],\"$L1d\"]}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"1e:I[79994,[\"1678\",\"static/chunks/mui-bfa73d562fb930cb.js\",\"5222\",\"static/chunks/emotion-85f0d021a4780287.js\",\"4121\",\"static/chunks/vendor-69a93a5bb874640e.js\",\"8039\",\"static/chunks/app/error-85c2501ce5331481.js\"],\"default\"]\n1f:I[11406,[\"1678\",\"static/chunks/mui-bfa73d562fb930cb.js\",\"5222\",\"static/chunks/emotion-85f0d021a4780287.js\",\"4121\",\"static/chunks/vendor-69a93a5bb874640e.js\",\"7811\",\"static/chunks/7811-82cf8748ce56c159.js\",\"7902\",\"static/chunks/7902-5b208dcf30526a1a.js\",\"7177\",\"static/chunks/app/layout-ea6f50a52db37e93.js\"],\"default\"]\n1c:[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$1e\",\"errorStyles\":[],\"errorScripts\":[],\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L5\",null,{}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]\n1d:[\"$\",\"$L1f\",null,{}]\n"])</script></body></html>