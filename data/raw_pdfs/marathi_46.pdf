cb,"])</script><script>self.__next_f.push([1,"\n          \u003cdiv\u003e\u003cstyle id=\"mceDefaultStyles\" type=\"text/css\"\u003e.mce-content-body div.mce-resizehandle {position: absolute;border: 1px solid black;box-sizing: box-sizing;background: #FFF;width: 7px;height: 7px;z-index: 10000}.mce-content-body .mce-resizehandle:hover {background: #000}.mce-content-body img[data-mce-selected],.mce-content-body hr[data-mce-selected] {outline: 1px solid black;resize: none}.mce-content-body .mce-clonedresizable {position: absolute;outline: 1px dashed black;opacity: .5;filter: alpha(opacity=50);z-index: 10000}.mce-content-body .mce-resize-helper {background: #555;background: rgba(0,0,0,0.75);border-radius: 3px;border: 1px;color: white;display: none;font-family: sans-serif;font-size: 12px;white-space: nowrap;line-height: 14px;margin: 5px 10px;padding: 5px;position: absolute;z-index: 10001}\n.mce-visual-caret {position: absolute;background-color: black;background-color: currentcolor;}.mce-visual-caret-hidden {display: none;}*[data-mce-caret] {position: absolute;left: -1000px;right: auto;top: 0;margin: 0;padding: 0;}\n.mce-content-body .mce-offscreen-selection {position: absolute;left: -9999999999px;max-width: 1000000px;}.mce-content-body *[contentEditable=false] {cursor: default;}.mce-content-body *[contentEditable=true] {cursor: text;}\n\u003c/style\u003e\u003clink rel=\"stylesheet\" type=\"text/css\" id=\"u0\" href=\"https://sra.gov.in/assets/tinymce/js/tinymce/skins/lightgray/content.min.css\"\u003e\u003clink rel=\"stylesheet\" type=\"text/css\" id=\"u1\" href=\"//www.tinymce.com/css/codepen.min.css\"\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c/div\u003e\u003cp\u003e\u003cspan style=\"font-size: 18px;\"\u003eThe following documents are required for the transfer of ownership of slum properties, in accordance with Section 3 (E) of the Maharashtra Slum Areas (Improvement, Clearance, and Redevelopment) Act, 1971, and Circular No. 145 issued by the Slum Rehabilitation Authority on 24.10.2021.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"font-size: 18px;\"\u003e\u0026nbsp;\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong style=\"font-size: 18px;\"\u003eDocuments and Information Required from Original Slum Dwellers:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"font-size: 18px;\"\u003e\u0026nbsp;\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eXerox Copy of the Annexure-II issued by the Competent Authority.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eXerox Copy of Allotment Letter/Possession Letter.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eXerox Copy of the Share Certificate from the Co-operative Housing Society\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eXerox Copy of the Aadhaar Card (Husband/Wife).\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eInformation regarding the allotment \u0026amp; rehab tournament by the Authority/ Society/Developer (Photo / List).\u003c/span\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong style=\"font-size: 18px;\"\u003eDocuments and Information of Resident /Shop Purchaser: \u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"font-size: 18px;\"\u003e\u0026nbsp;\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eIncome Certificate issued by the Competent Authority for the current year and Form 16 (current year + last 2 years).\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eNotarized Declaration in the Prescribed format on legal paper.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eDomicile Certificate issued by the Competent Authority.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eNo Objection Certificate (NOC) for the transfer from the Cooperative Housing Society.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size: 18px;\"\u003eCopy of Aadhaar Card of the Purchaser (Husband/Wife).\u003cbr\u003e\u003cbr\u003e\u003c/span\u003e\u003c/li\u003e\u003c/ol\u003e\u003ch4\u003e\u003ca href=\"https://transfersra.in/\" data-mce-href=\"https://transfersra.in/\" target=\"_blank\" style=\"font-size: 18px;\"\u003e\u003cspan style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"\u003e\u003cspan style=\"background-color: #ff0000;\" data-mce-style=\"background-color: #ff0000;\"\u003e\u003cspan style=\"background-color: #ffffff;\" data-mce-style=\"background-color: #ffffff;\"\u003eFor Online Transfer of Flat/Plot(Transfer\u0026nbsp;Of\u0026nbsp;Tenement) ⇒\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u0026nbsp;\u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/h4\u003e\u003ca href=\"https://transfer.sra.gov.in/\" target=\"_blank\" style=\"color: rgb(255, 255, 255); background-color: rgb(212, 103, 106); font-weight: bold; border: 2px solid white; display: inline-block; padding: 10px 20px; text-align: center; text-decoration: none; border-radius: 5px; cursor: pointer; transition: background-color 0.3s, color 0.3s; font-size: 18px;\" onmouseover=\"this.style.backgroundColor='#b95e65'; this.style.color='#fff';\" onmouseout=\"this.style.backgroundColor='#D4676A'; this.style.color='#fff';\"\u003e\n             Click Here\n          \u003c/a\u003e\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003e\u003cimg src=\"https://media.sra.gov.in/sra-automation/category/image/1731503424137_2673_Transfer%20Of%20Tenent%20Pam%20JPG%20File.webp\" alt=\"\" width=\"451\" style=\"display: block; margin-left: auto; margin-right: auto;\" height=\"301\"\u003e\u003c/div\u003e"])</script><script>self.__next_f.push([1,"1b:Tdb8,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003cspan data-teams=\"true\" style=\"font-size: 14px;\"\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSRA Kavach – Secure Digital Document System\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSRA Kavach\u003c/strong\u003e is a secure digital system introduced by the Slum Rehabilitation Authority (SRA), Mumbai, to \u003cstrong\u003eprotect important documents from forgery and misuse\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eUsing \u003cstrong\u003eAI-based verification and advanced digital security\u003c/strong\u003e, SRA Kavach ensures that documents like \u003cstrong\u003eGanana Pavti, Annexure II, Occupation Certificate, and Commencement Certificate\u003c/strong\u003e are \u003cstrong\u003egenuine, tamper-proof, and permanently verified\u003c/strong\u003e.\u003c/p\u003e\u003ch3\u003e\u003cstrong\u003eBenefits for Citizens\u003c/strong\u003e\u003c/h3\u003e\u003cul\u003e\u003cli\u003e✅ Only authentic documents are accepted\u003c/li\u003e\u003cli\u003e⚡ Faster processing and verification\u003c/li\u003e\u003cli\u003e🔍 Easy online search and download\u003c/li\u003e\u003cli\u003e🔒 Full transparency and trust\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eSRA Kavach ensures your documents remain safe, verified, and trusted.\u003c/strong\u003e\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\u003ctable\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"text-align: center;\"\u003e\u003cstrong\u003eTitle\u003c/strong\u003e\u003c/td\u003e\u003ctd style=\"text-align: center;\"\u003e\u003cstrong\u003eLink\u003c/strong\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eGanana pavati\u0026nbsp;\u003c/strong\u003e\u003cbr\u003e\u003c/td\u003e\u003ctd\u003e\u003ca aria-label=\"Link https://kavach.sra.gov.in/doc/1/search\" id=\"menur1gb\" href=\"https://kavach.sra.gov.in/doc/1/search\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"fui-Link ___1q1shib f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1s184ao f1mk8lai fnbmjn9 f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" title=\"https://kavach.sra.gov.in/doc/1/search\"\u003ehttps://kavach.sra.gov.in/doc/1/search\u003c/a\u003e\u003cbr\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eAnnexure 2\u003c/strong\u003e\u003cbr\u003e\u003c/td\u003e\u003ctd\u003e\u003ca aria-label=\"Link https://kavach.sra.gov.in/doc/2/search\" id=\"menur1gd\" href=\"https://kavach.sra.gov.in/doc/2/search\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"fui-Link ___1q1shib f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1s184ao f1mk8lai fnbmjn9 f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" title=\"https://kavach.sra.gov.in/doc/2/search\"\u003ehttps://kavach.sra.gov.in/doc/2/search\u003c/a\u003e\u003cbr\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eOC\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003e\u003cp\u003e\u003ca aria-label=\"Link https://kavach.sra.gov.in/doc/4/search\" id=\"menur1gf\" href=\"https://kavach.sra.gov.in/doc/4/search\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"fui-Link ___1q1shib f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1s184ao f1mk8lai fnbmjn9 f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" title=\"https://kavach.sra.gov.in/doc/4/search\"\u003ehttps://kavach.sra.gov.in/doc/4/search\u003c/a\u003e\u003c/p\u003e\u003c/td\u00