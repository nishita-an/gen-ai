    <!-- Code start for auto suggest -->

    <script>
		function change_lang(lang){
			if(lang != ""){
				$.ajax({
					type:'POST',
					url: serverpath+'ajax/add_session_lang',
					data: ({lang: lang}),
					cache: false,
					dataType: 'json',
					async: false,
					success: function(json)						
					{
						if(json.result)
						{
							window.location.reload();
						}
					}
				});
			}
		}
		
        document.addEventListener("DOMContentLoaded", function() {
            const solutions = [
                "Property KYC",
                "Property bill pay / view",
                "New property assessment",
                "Property transfer",
                "No dues certificate",
                "Property abstract"
            ];

            const suggestionBox = document.getElementById("suggestion-box");
            const showSuggestions = document.getElementById("showSuggestions");

            showSuggestions.addEventListener("click", function() {
                suggestionBox.innerHTML = "";
                solutions.forEach(solution => {
                    const div = document.createElement("div");
                    div.textContent = solution;
                    div.onclick = () => {
                        alert("You selected: " + solution); // Modify this action as needed
                        suggestionBox.style.display = "none";
                    };
                    suggestionBox.appendChild(div);
                });

                suggestionBox.style.display = "block";
            });

            document.addEventListener("click", (e) => {
                if (e.target !== showSuggestions && e.target !== suggestionBox) {
                    suggestionBox.style.display = "none";
                }
            });
        });
    </script>
    <!-- Code end for auto suggest -->

	<script>
        // Get elements
        const toggleBtn = document.getElementById('themeToggle');
        const body = document.body;
        const slider = document.querySelector('.toggle-slider');

        // Check for saved theme preference or default to 'light'
        const currentTheme = getTheme();
        
        // Apply saved theme on page load
        body.className = currentTheme;
        updateToggleButton(currentTheme);

        // Toggle button click event
        toggleBtn.addEventListener('click', () => {
            const currentMode = body.classList.contains('light-mode') ? 'light-mode' : 'dark-mode';
            const newMode = currentMode === 'light-mode' ? 'dark-mode' : 'light-mode';
            
            body.className = newMode;
            saveTheme(newMode);
            updateToggleButton(newMode);
        });

        // Function to get theme from memory
        function getTheme() {
            return window.themePreference || 'light-mode';
        }

        // Function to save theme to memory
        function saveTheme(theme) {
            window.themePreference = theme;
        }

        // Function to update toggle button appearance
        function updateToggleButton(theme) {
            if (theme === 'dark-mode') {
                toggleBtn.classList.add('active');
                slider.textContent = '🌙';
            } else {
                toggleBtn.classList.remove('active');
                slider.textContent = '☀️';
            }
        }

        // Optional: Listen for system theme changes
        if (window.matchMedia) {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
                if (!window.themePreference) {
                    const newTheme = e.matches ? 'dark-mode' : 'light-mode';
                    body.className = newTheme;
                    updateToggleButton(newTheme);
                }
            });
        }
    </script>

