	<style>
		.toggle-btn {
            position: relative;
			width: 35px;
    		height: 20px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 34px;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s ease;
            overflow: hidden;
        }

        .toggle-btn:hover {
            background: #fff;
        }

        .toggle-slider {
            position: absolute;
           	top: 2px;
			left: 0px;
			width: 15px;
			height: 15px;
            background: white;
            border-radius: 50%;
            transition: transform 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .toggle-btn.active .toggle-slider {
            transform: translateX(12px);
        }
