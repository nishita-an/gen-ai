		body.dark-mode .home-one .navbar-details .navigation-link .navbar-nav .nav-item .nav-link {
			color: #fff;
		}
		body.dark-mode .indiagov {
			background: #fff;
		}
		body.dark-mode .home-one .banner-card .card {
			background: #2b2c2f;
			box-shadow: 0 0 11px 0 rgb(255 255 255 / 13%);
		}
		body.dark-mode .home-one .banner-card .card:hover img {
