						<input type="text" name="email_id" placeholder="Email ID">
						<div id="email_err" class="error"></div>
					</div><div class="formElememnt asideSection col6">
						<input type="text" name="mobile_no" placeholder="Mobile Number">
						<div id="mobile_no_err" class="error"></div>
					</div><div class="formElememnt asideSection col12">
						<textarea placeholder="Feedback" name="message"></textarea>
						<div id="feedback_err" class="error"></div>
					</div><div class="formElememnt asideSection col12">
						<input type="submit" name="Submit" id="feed_submit_btn" value="Submit">
					</div><div class="formElememnt success_msg"></div><div class="failure_msg error"></div>
				</form>
			</div>
		
