        <ul class="filter-group-list">





        </ul>
    </div>
</div>

</div>

    <div class="mod mod-filter-result" data-connectors="filter" data-filter-id="1">
        <div class="h-hidden js-results-tpl">
            {{~it.Items :item}}
                
{{? item.Type === 'News' }}
    
<div class="teaser-news">
    <div class="teaser-info">
        <span class="teaser-info-date">{{=item.Date}}</span>
        <span class="teaser-info-date-mobile">{{=item.DateMobile}}</span>
        {{? item.Category != null}} {{? item.Category.length}}
        {{~item.Category.split(',') :k}}
            <div class="teaser-tag-label">{{=k}}</div>
        {{~}}
	    {{?}}
        {{?}}
    </div>
    <div class="teaser-content">
        <a class="teaser-content-title" href="{{=item.Link}}">
            <h2>{{=item.Title}}</h2></a>
        <div class="teaser-content-text">{{? item.Description != null}} {{=item.Description}} {{?}}</div>
        <a class="e-text text-link-std bold" href="{{=item.Link}}">Weiterlesen</a>
    </div>
</div>


{{?? item.Type === 'Doc' }}
    <div class="document-teaser-box          nobackground
" data-isBeingWatchedFlag="{{=item.IsBeingWatched}}">
    <a class="e-btn btn-icon icon-document {{=item.Extension}}"  title="{{=item.Title}}" href="{{=item.Link}}" target="_blank"></a>

    <div class="document-teaser-box-content">
        <a class="document-teaser-box-title"  title="{{=item.Title}}" href="{{=item.Link}}" target="_blank">{{=item.Title}}</a>

        <p class="document-teaser-box-text js-document-teaser-box-text">{{=item.Description}}</p>

        <div class="document-teaser-box-info js-document-teaser-box-info">
            <span class="document-teaser-box-update">Zuletzt geändert: {{=item.Date}}</span>
            <span class="document-teaser-box-size">Grösse: {{=item.Size}} MB</span>
            {{?item.OtherLanguageLinks}}
            <ul class="document-teaser-language-list">
                <li class="document-teaser-box-language-title">Sprache(n):</li>
                {{~item.OtherLanguageLinks :lang}}
                <li class="document-teaser-box-language-label">
                    <a target="_blank" href="{{=lang.Url}}" data-download-title="{{=item.Title}}" data-download-lang="{{=lang.Name}}">{{=lang.Name}}</a>
                </li>
                {{~}}
            </ul>
            {{?}}
        </div>
    </div>
    <a class="e-btn btn-icon icon-notification js-icon-notification" data-id="{{=item.Id}}" href="javascript:;" rel="tooltip" title="Zur Merkliste hinzuf&#252;gen"
       data-addtext="Zur Merkliste hinzufügen"
       data-removetext="Aus der Merkliste entfernen"
       data-mobile-addalerttext="Dokument wurde zur Merkliste hinzugefügt."
       data-mobile-removealerttext="Dokument wurde aus der Merkliste entfernt.">
        <span class="notification-text" data-addwatchlist="{{=item.WatchlistUrl}}" data-deleteonewatchlisturl="{{=item.DeleteOneWatchlistUrl}}">Zur Merkliste hinzufügen</span>
    </a>
    <span class="document-teaser-nav-mobile js-document-teaser-nav-mobile"></span>
</div>



{{?? item.Type === 'Page' }}
    
<div class="teaser-news">
    <div class="teaser-info">
        <span class="teaser-info-date">{{=item.Date}}</span>
        <span class="teaser-info-date-mobile">{{=item.DateMobile}}</span>
        {{? item.Category != null}} {{? item.Category.length}}
        {{~item.Category.split(',') :k}}
            <div class="teaser-tag-label">{{=k}}</div>
        {{~}}
	    {{?}}
        {{?}}
    </div>
    <div class="teaser-content">
        <a class="teaser-content-title" href="{{=item.Link}}">
            <h2>{{=item.Title}}</h2></a>
        <div class="teaser-content-text">{{? item.Description != null}} {{=item.Description}} {{?}}</div>
        <a class="e-text text-link-std bold" href="{{=item.Link}}">Weiterlesen</a>
    </div>
</div>


{{?? item.Type === 'Sro' }}
    
<table class="e-table vertical-sorting table-sorting">
	<thead class="cf">
		<tr>
			<th data-sort="string">Firmenname</th>
			<th data-sort="string">Sitz</th>
			<th data-sort="string">Überwachende SRO</th>
		</tr>
	</thead>
    <tbody>
    {{~it.Items :item}}
        <tr>
            <td data-title="Firmenname">{{=item.CompanyName}}</td>
            <td data-title="Sitz">{{=item.Domicile}}</td>
            <td data-title="Überwachende SRO">{{=item.MonitoringSro}}</td>
        </tr>
    {{~}}
    {{? it.Items.length == 0}}
        {{? it.Resultstring != null}}
        <tr>
            <td>{{=it.Resultstring}}</td>
            <td></td>
            <td></td>
        </tr>
        {{?}}
    {{?}}
    </tbody>
</table>
{{?? item.Type === 'InsuranceIntermediaries' }}
    
<table class="e-table vertical-sorting table-sorting" id="vvg">
    <thead class="cf">
        <tr>
            <th data-sort="string">Registernummer</th>
            <th data-sort="string">Name</th>
        </tr>
    </thead>
    <tbody>
        {{~it.Items :item}}
        <tr>
            <td data-title="Registernummer"><a href="{{=item.Link}}">{{=item.RegistrationNumber}}</a></td>
            <td data-title="Name">{{=item.Name}}</td>
        </tr>
        {{~}}
        {{? it.Items.length == 0}}
        {{? it.Resultstring != null}}
        <tr>
            <td>{{=it.Resultstring}}</td>
            <td></td>
            <td></td>
        </tr>
        {{?}}
        {{?}}
    </tbody>
</table>
<div>
    {{?it.LastPageLink}}
    <span class="show-last h-left">
        <a class="e-btn btn-standard" href="javascript:;">Letzte laden</a>
    </span>
    {{?}}

    {{?it.NextPageLink}}
    <span class="show-next h-right">
        <a class="e-btn btn-standard" href="javascript:;">Nächste laden</a>
    </span>
    {{?}}
</div>
{{?? item.Type === 'Event' }}
    
<div class="teaser-news">
    <div class="teaser-info">
        <span class="teaser-info-date">{{=item.Date}}</span>
        <span class="teaser-info-date-mobile">{{=item.Date}}</span>
        {{~ (function(){ return item.Category.split(',')})() :k}}
            <div class="teaser-tag-label">{{=k}}</div>
        {{~}}
    </div>
    <div class="teaser-content">
        <a class="teaser-content-title" href="{{=item.Link}}">
            <h2>{{=item.Title}}</h2>
        </a>

        <dl class="teaser-appointment-list">
            
            {{? item.EventDate != null}}
            <dd class="list-item-screen">
                Datum: {{=item.EventDate}}
            </dd>
            {{?}}

            {{? item.EventDate != null}}
