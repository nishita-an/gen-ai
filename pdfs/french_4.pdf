                Datum: {{=item.EventDate}}
            </dd>
            {{?}}

            {{? item.EventTime != null}}
            <dd class="list-item">
                Zeit: {{=item.EventTime}} Uhr
            </dd>
            {{?}}

            {{? item.EventLocation != null}}
