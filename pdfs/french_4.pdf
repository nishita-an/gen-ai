                Ort: {{=item.EventLocation}}
            </dd>
            {{?}}

        </dl>

        <p class="teaser-content-text">{{=item.Description}}</p>
        <a class="e-text text-link-std bold" href="{{=item.Link}}">Weiterlesen</a>
    </div>
</div>

{{?}}
            {{~}}
            {{?it.NextPageLink}}
            <div class="show-more">
                <a class="e-btn btn-standard" href="javascript:;">Weitere laden</a>
            </div>
            {{?}}
        </div>
        <div class="result-headline">
            <p class="result-count empty"><span class="js-count"></span> Ergebnis(se) <span>gefunden</span></p>
                    </div>

        <div class="mod mod-teaser mod-document-teaser nobackground js-results">
